# Copy to .env.local (gitignored). Used by scripts/push-distribution-secrets-to-github.sh
# and scripts/virustotal-scan.mjs (npm run scan:virustotal).
# Never commit real values.

# https://community.chocolatey.org → Sign in → Account → API Key
CHOCOLATEY_API_KEY=

# Path to armored GPG secret key (see ~/private/apt-signing/)
APT_GPG_KEY_FILE=/Users/you/private/apt-signing/apt-signing-private.asc

# Optional: GitHub PAT with repo + workflow (push homebrew-tap, apt, gh secret set).
# If unset, push script uses `gh auth token` when logged in via `gh auth login`.
# TAP_TOKEN=

# VirusTotal — https://www.virustotal.com/gui/my-apikey (same key as cursor-auto-runner)
VIRUSTOTAL_API_KEY=

# Set to 1 to exit non-zero when any engine reports malicious (default: warn only)
# VIRUSTOTAL_FAIL_ON_DETECTION=0

# Minutes to wait for queued analyses before reporting them as pending (default 45)
# VIRUSTOTAL_WAIT_MINUTES=45
